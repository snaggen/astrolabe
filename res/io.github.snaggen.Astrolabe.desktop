[Desktop Entry]
Name=Astrolabe
GenericName=Web Browser
Comment=A web browser for the COSMIC desktop
Categories=Network;WebBrowser;
Exec=astrolabe %u
Icon=io.github.snaggen.Astrolabe
Terminal=false
Type=Application
StartupNotify=true
StartupWMClass=io.github.snaggen.Astrolabe
MimeType=text/html;text/xml;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
