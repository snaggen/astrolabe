[Desktop Entry]
Name=COSMIC Web
GenericName=Web Browser
Comment=A web browser for the COSMIC desktop
Categories=Network;WebBrowser;
Exec=cosmic-web %u
Icon=io.github.snaggen.CosmicWeb
Terminal=false
Type=Application
StartupNotify=true
StartupWMClass=io.github.snaggen.CosmicWeb
MimeType=text/html;text/xml;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
